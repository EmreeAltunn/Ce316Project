<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
  WelcomeView.fxml
  Uygulamanin acilis ekrani. MainController contentArea'sina yuklenir.
-->
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.iae.ui.controller.WelcomeController"
      spacing="14"
      alignment="CENTER"
      style="-fx-background-color: #FAFAFA;">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="IAE — Integrated Assignment Environment"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1A237E;"/>
    <Label text="Create a new project or open an existing one to get started."
           style="-fx-text-fill: #616161;"/>

    <Separator maxWidth="360"/>

    <VBox spacing="10" alignment="CENTER" maxWidth="260">
        <Button text="New Project" onAction="#handleNewProject" maxWidth="Infinity"
                style="-fx-background-color: #1565C0; -fx-text-fill: white;"/>
        <Button text="Open Project" onAction="#handleOpenProject" maxWidth="Infinity"
                style="-fx-background-color: #1565C0; -fx-text-fill: white;"/>
        <Button text="Manage Configurations" onAction="#handleManageConfigurations" maxWidth="Infinity"
                style="-fx-background-color: #5C6BC0; -fx-text-fill: white;"/>
    </VBox>

</VBox>
